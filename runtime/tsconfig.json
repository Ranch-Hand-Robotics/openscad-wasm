{
  "include": ["src"],
  "exclude": ["dist"],
  "compilerOptions": {
    "module": "node16",
    "target": "esnext",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationDir": ".",
  }
}
